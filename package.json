{
  "name": "@roberttlange/ask",
  "version": "0.1.1",
  "description": "Ask usage questions about installed command-line tools.",
  "license": "Apache-2.0",
  "author": "Robert Lange <robertlange0@gmail.com>",
  "homepage": "https://github.com/RobertTLange/ask-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertTLange/ask-cli.git"
  },
  "bugs": {
    "url": "https://github.com/RobertTLange/ask-cli/issues"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "headless",
    "llm",
    "documentation",
    "package-inspection"
  ],
  "type": "module",
  "bin": {
    "ask": "bin/ask.js"
  },
  "main": "./dist/cli/index.js",
  "exports": {
    ".": "./dist/cli/index.js"
  },
  "files": [
    "bin",
    "CHANGELOG.md",
    "config.toml.example",
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/test.js",
    "test:integration:local": "node --test tests/integration-local.test.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "smol-toml": "^1.6.1"
  }
}
